GMAT GPS19.DateFormat = UTCGregorian;
GMAT GPS19.Epoch = '01 Jan 2026 00:00:00.000';
GMAT GPS19.CoordinateSystem = EarthMJ2000Eq;
GMAT GPS19.DisplayStateType = Keplerian;
GMAT GPS19.SMA = 26560;
GMAT GPS19.ECC = 0.0;
