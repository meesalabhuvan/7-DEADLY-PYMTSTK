%----------------------------------------
%  GPS Constellation PDOP Analysis Script
%  General Mission Analysis Tool (GMAT)
%----------------------------------------
%  Purpose: Analyze Position Dilution of Precision (PDOP)
%  for a ground receiver using a 24-satellite GPS constellation
%  ALL OUTPUTS IN EarthFixed (ECEF) FRAME - NO MIXING
%----------------------------------------

%----------------------------------------
%  GPS Constellation (24 Satellites)
%  6 Orbital Planes, 4 Satellites per Plane
%----------------------------------------

% Plane 1 (RAAN = 0 deg)
Create Spacecraft GPS1;
GMAT GPS1.DateFormat = UTCGregorian;
GMAT GPS1.Epoch = '01 Jan 2026 00:00:00.000';
GMAT GPS1.CoordinateSystem = EarthMJ2000Eq;
GMAT GPS1.DisplayStateType = Keplerian;
GMAT GPS1.SMA = 26560;
GMAT GPS1.ECC = 0.0;
GMAT GPS1.INC = 55.0;
GMAT GPS1.RAAN = 0.0;
GMAT GPS1.AOP = 0.0;
GMAT GPS1.TA = 0.0;

